[Unit]
Description=EV3 RL Line Follower
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/robot/EV3_RL_LineFollower/main.py
WorkingDirectory=/home/robot/EV3_RL_LineFollower
Environment=PYTHONUNBUFFERED=1
User=robot
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
